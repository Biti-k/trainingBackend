# Google Gemini API key — https://aistudio.google.com/apikey
API_GEMINI=

# PostgreSQL connection string, e.g. postgresql://user:password@host:5432/dbname
URL_POSTGRES=

# Optional: separate connection string for the session-store/pooled connection,
# if your provider distinguishes between a direct and a pooled URL
URL_POSTGRES_SESSION=

# Google OAuth 2.0 credentials — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Frontend origin, used for CORS and for the post-login redirect
FRONTEND_URL=http://localhost:4321

# Random secret used to sign session JWTs — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
